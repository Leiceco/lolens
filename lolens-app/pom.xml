<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lolens</groupId>
        <artifactId>lolens</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>lolens-app</artifactId>
    <name>LoLens App</name>
    <description>主程序：Launcher 入口、JavaFX Application、Bootstrap 装配。</description>

    <dependencies>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>lolens-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>lolens-services</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>lolens-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-build</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-counter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-enemy-stats</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-skill-timer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-auto-accept</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-respawn-timer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-match-history</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-pick-ban</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-honor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-auto-reply</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-lobby-flow</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-chat-status</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.lolens</groupId>
            <artifactId>module-core-overlay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.lolens.app.Main</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.lolens.app.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
